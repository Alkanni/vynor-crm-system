# ==============================================================================
# VYNOR CRM — Root Monorepo Environment Configuration (.env.example)
#
# Copy this file to .env at the root or into individual app directories.
# Never commit real credentials to version control.
# ==============================================================================

# Application Profile & Global Flags
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Service Ports & URLs
API_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Connections (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public

# Supabase Auth
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# S3 / RustFS Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vynor-crm-attachments
STORAGE_ACCESS_KEY_ID=rustfsadmin
STORAGE_SECRET_ACCESS_KEY=rustfsadminpassword
STORAGE_USE_SSL=false

# Queue Configuration
PG_BOSS_SCHEMA=pgboss
PG_BOSS_RETENTION_DAYS=14

# Frontend Public Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Observability (Optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Provider Webhook Tokens (Optional)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
