# ==============================================================================
# VYNOR CRM — Worker Environment Configuration (.env.example)
#
# IMPORTANT: This file contains variable names, types, and descriptions only.
# NEVER commit real passwords, tokens, or credentials to git.
# Copy this file to .env and fill in the values for your local environment.
# ==============================================================================

# Application Profile
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Error Tracking (Optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Database Connections (Supabase PostgreSQL)
# DATABASE_URL: Pooled or direct connection string used by pg-boss workers and domain queries
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public

# DIRECT_URL: Direct connection string for schema/table creation
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public

# Queue Configuration (pg-boss)
PG_BOSS_SCHEMA=pgboss
PG_BOSS_RETENTION_DAYS=14

# Object Storage (RustFS / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vynor-crm-attachments
STORAGE_ACCESS_KEY_ID=rustfsadmin
STORAGE_SECRET_ACCESS_KEY=rustfsadminpassword
STORAGE_USE_SSL=false

# Optional Redis
# REDIS_URL=redis://localhost:6379

# Channel Integrations — see docs/channel-setup-guide.md
# ENCRYPTION_MASTER_KEY must be the same value as the API (it decrypts channel credentials to
# send replies and poll mailboxes). Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=v1
ENCRYPTION_PREVIOUS_KEYS=
META_GRAPH_API_VERSION=v26.0
CHANNEL_HTTP_TIMEOUT_MS=15000

# Polling loops: IMAP mailboxes, and Telegram bots when the API has no public HTTPS URL.
# A database lease lets only one worker poll each channel at a time, so every worker can keep it on.
CHANNEL_POLLING_ENABLED=true
EMAIL_POLL_INTERVAL_SECONDS=30
TELEGRAM_POLL_INTERVAL_SECONDS=3
