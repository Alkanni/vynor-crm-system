# ==============================================================================
# VYNOR CRM — API Environment Configuration (.env.example)
#
# IMPORTANT: This file contains variable names, types, and descriptions only.
# NEVER commit real passwords, tokens, or credentials to git.
# Copy this file to .env and fill in the values for your local environment.
# ==============================================================================

# Application Profile & Server Port
NODE_ENV=development
APP_ENV=local
PORT=3001
APP_URL=http://localhost:3001
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Error Tracking (Optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Database Connections (Supabase PostgreSQL)
# DATABASE_URL: Pooled connection string (Transaction pooler via PgBouncer / Supavisor, port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public

# DIRECT_URL: Direct database connection string (Port 5432) for running migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public

# Supabase Auth & JWT Verification
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Object Storage (RustFS / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vynor-crm-attachments
STORAGE_ACCESS_KEY_ID=rustfsadmin
STORAGE_SECRET_ACCESS_KEY=rustfsadminpassword
STORAGE_USE_SSL=false

# Optional Redis Cache / Fan-Out (Leave unset unless explicitly testing multi-node Socket.IO)
# REDIS_URL=redis://localhost:6379

# Channel Integrations — see docs/channel-setup-guide.md
# Channel credentials (tokens, app secrets, mailbox passwords) are entered in the app per
# channel and stored encrypted; they are not configured here.
# ENCRYPTION_MASTER_KEY: 32-byte base64 key, the same value as the worker. Required before any
# channel can be connected; mandatory in staging/production. Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=v1
# Retired keys still accepted for decryption while rotating, e.g. v0:BASE64KEY
ENCRYPTION_PREVIOUS_KEYS=

# PUBLIC_WEBHOOK_BASE_URL: public HTTPS origin providers call, e.g. https://crm.example.com or
# a tunnel URL for local testing. Defaults to APP_URL. Without HTTPS, Telegram falls back to
# polling and WhatsApp/Messenger/Instagram/LINE cannot deliver webhooks.
PUBLIC_WEBHOOK_BASE_URL=
META_GRAPH_API_VERSION=v26.0
CHANNEL_HTTP_TIMEOUT_MS=15000

# Local development only: enables POST /api/v1/auth/dev-session and the "Sign in as local
# admin" button, issuing sessions for seeded users. Ignored unless APP_ENV is local or test.
AUTH_DEV_SESSION_ENABLED=false
