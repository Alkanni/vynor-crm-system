# ==============================================================================
# VYNOR CRM — Frontend Web Environment Configuration (.env.example)
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are bundled into browser assets.
# NEVER put private API secrets, database passwords, or private keys into NEXT_PUBLIC_!
# ==============================================================================

# Public Browser Endpoints & Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Supabase Auth Public Identity Endpoint
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# Frontend Error Tracking (Optional)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Server-Only Next.js Runtime Secrets (Never exposed to client bundles)
NODE_ENV=development
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
