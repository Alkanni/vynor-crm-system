// Prisma Schema for VYNOR CRM
// Connected to Supabase PostgreSQL with pooled runtime and direct migration URLs

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

enum SystemRoleName {
  SUPER_ADMIN
  ADMIN
  AGENT
  AI_BOT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model Workspace {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  timezone  String    @default("UTC") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]
  roles       Role[]
  outboxEvents OutboxEvent[]

  @@map("workspaces")
}

model UserProfile {
  id             String    @id @default(cuid())
  supabaseAuthId String    @unique @map("supabase_auth_id") @db.VarChar(64)
  email          String    @unique @db.VarChar(255)
  displayName    String    @map("display_name") @db.VarChar(255)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(1024)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]

  @@map("user_profiles")
}

model WorkspaceMembership {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  userProfileId String           @map("user_profile_id")
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userProfile UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@unique([workspaceId, userProfileId], map: "uq_workspace_memberships_workspace_user")
  @@index([workspaceId], map: "idx_workspace_memberships_workspace_id")
  @@index([userProfileId], map: "idx_workspace_memberships_user_profile_id")
  @@map("workspace_memberships")
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([workspaceId, name], map: "uq_roles_workspace_name")
  @@index([workspaceId], map: "idx_roles_workspace_id")
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  category    String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([category], map: "idx_permissions_category")
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String   @map("membership_id")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([membershipId], map: "idx_membership_roles_membership_id")
  @@index([roleId], map: "idx_membership_roles_role_id")
  @@map("membership_roles")
}

model OutboxEvent {
  id           String            @id @default(uuid())
  workspaceId  String            @map("workspace_id")
  eventType    String            @map("event_type") @db.VarChar(100)
  payload      Json
  status       OutboxEventStatus @default(PENDING)
  retryCount   Int               @default(0) @map("retry_count")
  lastError    String?           @map("last_error") @db.Text
  scheduledAt  DateTime          @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  processedAt  DateTime?         @map("processed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt], map: "idx_outbox_events_status_scheduled_at")
  @@index([workspaceId, eventType], map: "idx_outbox_events_workspace_event_type")
  @@map("outbox_events")
}
