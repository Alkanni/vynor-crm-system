# ==============================================================================
# Database Environment Configuration (.env.example)
# ==============================================================================
# In Supabase PostgreSQL architecture, two distinct URLs are required:
#
# 1. DATABASE_URL:
#    - Pooled connection string used by the runtime application (API, worker).
#    - Connects via Supavisor / PgBouncer on port 6543 (transaction pooling mode).
#    - Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# 2. DIRECT_URL:
#    - Direct session connection string used exclusively by Prisma CLI migrations.
#    - Connects directly to PostgreSQL on session port 5432.
#    - Direct connection is required because connection poolers do not support DDL,
#      prepared statements, or advisory locks needed during migrations.
#    - Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# 3. TEST_DATABASE_URL (Optional):
#    - Dedicated isolated test database for running integration tests and test-utils cleanDatabase.
#    - Example: postgresql://postgres:postgres@localhost:54322/vynor_crm_test
# ==============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vynor_crm?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynor_crm_test?schema=public"
