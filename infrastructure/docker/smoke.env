# Compose smoke (WU-01): host ports only, all bound to 127.0.0.1 by compose.smoke.yml.
# No secrets, no external URLs. Read only through infrastructure/scripts/compose-smoke.sh,
# which runs compose with a sanitized environment, so shell variables cannot override these.
SMOKE_POSTGRES_PORT=55432
SMOKE_RUSTFS_API_PORT=59000
SMOKE_RUSTFS_CONSOLE_PORT=59001
SMOKE_API_PORT=53001
SMOKE_WEB_PORT=53000
SMOKE_CADDY_HTTPS_PORT=58443
